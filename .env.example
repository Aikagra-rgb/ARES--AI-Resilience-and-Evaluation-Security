# ARES Security & Evaluation System Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API Server Configuration
# =============================================================================
ARES_API_BASE_URL=http://localhost:8000
ENVIRONMENT=development  # development, staging, production

# =============================================================================
# Authentication & Security (REQUIRED IN PRODUCTION)
# =============================================================================
# Generate a secure key: openssl rand -hex 32
ARES_API_KEY=ares-dev-secret-key-42  # CHANGE IN PRODUCTION!
ARES_AUTH_ENABLED=true

# Canary token for gateway (generate: openssl rand -hex 32)
GATEWAY_CANARY_TOKEN=CANARY_ARES_SECRET_42  # CHANGE IN PRODUCTION!

# Prompt fingerprint secret (generate: openssl rand -hex 32)
PROMPT_FINGERPRINT_SECRET=development-only-change-me  # CHANGE IN PRODUCTION!

# Execution payload encryption key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
EXECUTION_PAYLOAD_ENCRYPTION_KEY=  # REQUIRED IN PRODUCTION

# =============================================================================
# LLM Providers (at least one required)
# =============================================================================
# Groq (Primary - fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Google Gemini (Secondary - good for evaluation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DEFAULT_MODEL=gemini-3.7-flash

# NVIDIA NIM (Tertiary - for hardening)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Ollama (Local - for embeddings or offline use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
PREFER_LOCAL_EMBEDDINGS=false

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
QDRANT_URL=  # e.g., https://your-cluster.qdrant.io (empty = local)
QDRANT_API_KEY=  # Optional, for Qdrant Cloud
QDRANT_COLLECTION=ares_attacks
QDRANT_VECTOR_SIZE=768

# Embedding provider
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_FALLBACK_TO_GEMINI=true

# =============================================================================
# Role Assignments (which provider does what)
# =============================================================================
ATTACKER_PROVIDER=groq
VICTIM_PROVIDER=groq
JUDGE_PROVIDER=gemini
HARDENER_PROVIDER=nvidia
HARDENER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=sqlite:///./ares.db  # Use postgresql://... in production

# =============================================================================
# CORS Origins (comma-separated)
# =============================================================================
CORS_ORIGINS=http://localhost:5000,https://localhost:5001,http://localhost:5149,https://localhost:7149,http://localhost:5180,https://localhost:7180

# =============================================================================
# Resilience & Fallback Settings
# =============================================================================
FALLBACK_ORDER=groq,gemini,nvidia,ollama
MAX_RETRIES=3
RETRY_MIN_WAIT_SECONDS=0.5
RETRY_MAX_WAIT_SECONDS=4.0
REQUEST_TIMEOUT_SECONDS=30.0

# =============================================================================
# Gateway Thresholds
# =============================================================================
GATEWAY_BLOCK_THRESHOLD=0.82
GATEWAY_SANITIZE_THRESHOLD=0.68

# =============================================================================
# Data Protection (Frontend)
# =============================================================================
# DataProtection:KeysPath=/path/to/keys  # Production only
