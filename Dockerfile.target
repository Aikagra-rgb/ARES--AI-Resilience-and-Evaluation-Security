FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.lock pyproject.toml ./
RUN pip install -r requirements.lock

COPY app ./app
COPY ares ./ares
COPY data/models ./data/models
COPY tests/targets ./tests/targets
RUN ENVIRONMENT=test DATABASE_URL=sqlite:///:memory: python -m ares.training.client_model_trainer --org=all \
    && test -f models/org_acme_fintech/intent_classifier/ml_stats.json

RUN useradd --system --uid 10001 --no-create-home ares && chown -R ares:ares /app
USER ares

EXPOSE 8001
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/healthz', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "tests.targets:app", "--host", "0.0.0.0", "--port", "8001"]
