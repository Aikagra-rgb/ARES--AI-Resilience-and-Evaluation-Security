<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0a0c" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap">
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/svg+xml" href="icon.svg" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer"
            AntiforgeryFieldName="@_antiforgeryFieldName"
            AntiforgeryRequestToken="@_antiforgeryRequestToken" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="ares-temple.js"></script>
    <script src="ares-control-surface.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [Inject]
    private Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery { get; set; } = default!;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string _antiforgeryFieldName = "__RequestVerificationToken";
    private string _antiforgeryRequestToken = string.Empty;

    protected override void OnInitialized()
    {
        if (HttpContext is not null && !HttpContext.Response.HasStarted)
        {
            var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
            _antiforgeryFieldName = tokens.FormFieldName;
            _antiforgeryRequestToken = tokens.RequestToken ?? string.Empty;
        }
    }
}
