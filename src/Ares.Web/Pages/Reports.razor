@page "/reports"
@implements IDisposable
@inject IAresApiClient Api
@inject IJSRuntime JS

<PageTitle>Reports · ARES</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading security reports…" />
}
else if (_error is not null)
{
    <ErrorState Title="Reports unavailable" Message="@_error" Retry="LoadAsync" />
}
else
{
    <section class="page-intro dashboard-intro">
        <div>
            <p class="eyebrow">Evaluation history</p>
            <h1>Security Reports</h1>
            <p>All red-team evaluation, prompt hardening, corpus ingestion, and ML analytics reports.</p>
        </div>
        <div class="intro-meta" style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
            <div>
                <span style="display:block;font-size:0.75rem;">Last refreshed</span>
                <strong>@DateTime.UtcNow.ToString("dd MMM yyyy, HH:mm") UTC</strong>
            </div>
            <button class="button button-primary" style="font-size:0.8rem;" @onclick="GenerateExecutiveSummary">
                📥 Export Executive Audit (.md)
            </button>
            <button class="text-button" @onclick="LoadAsync">Refresh</button>
        </div>
    </section>

    <div class="dashboard-two-col lower-grid" style="margin-bottom:1.5rem">

        @* Robustness Report *@
        <article class="surface-card hardening-panel">
            <div class="section-heading compact">
                <div><p class="eyebrow">Autonomous Red-Teaming Suite</p><h2>Model Robustness Sweep</h2></div>
                <span class="subtle-code">BACKGROUND SUITE</span>
            </div>
            @if (_recent?.Count > 0)
            {
                var latest = _recent[0];
                <div class="hardening-rates">
                    <div><span>ASR / Risk</span><strong>@latest.RiskScore%</strong></div>
                    <span class="rate-arrow" aria-hidden="true">·</span>
                    <div><span>Robustness</span><strong>@(100 - latest.RiskScore)%</strong></div>
                </div>
                <div class="improvement-callout">
                    <span>Sweep executed</span><strong>@latest.Timestamp.ToString("dd MMM yyyy, HH:mm") UTC</strong>
                    <p>Provider: <strong>@latest.Provider</strong> · Model: <code>@latest.Model</code></p>
                </div>
                <div style="display:flex;gap:0.5rem;margin-bottom:0.5rem;">
                    <button class="button button-primary" style="flex:1;" @onclick="() => ViewAuditReportAsync(latest.Id)">
                        📄 View Security Audit
                    </button>
                    <a class="button button-secondary" style="flex:1;" href="@($"/optimizer?tab=system_hardener&testId={Uri.EscapeDataString(latest.Id)}")">
                        🛡️ Immunize in Optimizer
                    </a>
                </div>
            }
            else
            {
                <div class="hardening-rates">
                    <div><span>ASR / Risk</span><strong>0%</strong></div>
                    <span class="rate-arrow" aria-hidden="true">·</span>
                    <div><span>Robustness</span><strong>—</strong></div>
                </div>
                <div class="improvement-callout">
                    <span>Sweep status</span><strong>No sweeps recorded</strong>
                    <p>Corpus size: @(_stats?.CorpusSize.ToString("N0") ?? "0") vectors · 0 test runs executed</p>
                </div>
            }
            <div style="display:flex;gap:0.5rem;margin-top:0.75rem;">
                <a class="button button-secondary" style="flex:1;" href="/optimizer">⚡ Prompt Optimizer</a>
                <a class="button button-secondary" style="flex:1;" href="/gateway">🛡️ Runtime Gateway</a>
            </div>
        </article>

        @* Hardening Report *@
        <article class="surface-card hardening-panel">
            <div class="section-heading compact">
                <div><p class="eyebrow">Zero-Trust Synthesis</p><h2>Prompt Hardening Benchmark</h2></div>
                <span class="subtle-code">@(_hardening.LastCycle != DateOnly.MinValue ? _hardening.LastCycle.ToString("dd MMM yyyy") : "No runs yet")</span>
            </div>
            <div class="hardening-rates">
                <div><span>Baseline ASR</span><strong>@_hardening.BaselineSuccessRate%</strong></div>
                <span class="rate-arrow" aria-hidden="true">→</span>
                <div><span>Hardened ASR</span><strong>@_hardening.HardenedSuccessRate%</strong></div>
            </div>
            <div class="improvement-callout">
                <span>Robustness gain</span>
                <strong style="color:#10b981;">+@_hardening.ImprovementPoints pts</strong>
                <p>@(_hardening.TestsIncluded > 0 ? $"Across {_hardening.TestsIncluded} controlled test{(_hardening.TestsIncluded == 1 ? "" : "s")}." : "No controlled hardening runs recorded yet.")</p>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:0.75rem;">
                <a class="button button-primary" style="flex:1;" href="/optimizer">Open Prompt Optimizer</a>
            </div>
        </article>
    </div>

    @* ML Analytics Report *@
    <article class="surface-card provider-panel" style="margin-bottom:1.5rem" aria-labelledby="ml-report-heading">
        <div class="section-heading compact">
            <div><p class="eyebrow">ML vector analytics</p><h2 id="ml-report-heading">Classification Model Report</h2></div>
            <span class="subtle-code">CORPUS: @(_stats?.CorpusSize.ToString("N0") ?? "—") VECTORS</span>
        </div>
        @if (_stats is not null)
        {
            <ul class="provider-list">
                <li style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--border)">
                    <span>Overall Accuracy</span><strong class="accent-green">@_stats.OverallAccuracy.ToString("F1")%</strong>
                </li>
                <li style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--border)">
                    <span>CV Accuracy (5-fold)</span><strong>@_stats.CvAccuracy.ToString("F1")% ±@_stats.CvStd.ToString("F1")%</strong>
                </li>
                <li style="display:flex;justify-content:space-between;padding:0.5rem 0;border-bottom:1px solid var(--border)">
                    <span>Corpus size</span><strong>@_stats.CorpusSize.ToString("N0") vectors</strong>
                </li>
                <li style="display:flex;justify-content:space-between;padding:0.5rem 0">
                    <span>Classifier</span><span class="subtle-code" style="font-size:0.75rem">@_stats.ModelName.Split('|')[0].Trim()</span>
                </li>
            </ul>
        }
        else
        {
            <EmptyState Eyebrow="No report" Title="ML report not found."
                        Message="Run scripts/run_ml_statistics.py to generate the report." />
        }
        <a class="button button-secondary" href="/stats" style="margin-top:1rem">View full ML analytics</a>
    </article>

    @* Recent Test History *@
    @if (_recent?.Count > 0)
    {
        <section class="surface-card" aria-labelledby="history-heading">
            <div class="section-heading compact">
                <div><p class="eyebrow">Evaluation history</p><h2 id="history-heading">Recent test runs</h2></div>
            </div>
            <div class="history-table-wrap">
                <table class="data-table">
                    <caption class="sr-only">Recent test runs</caption>
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Timestamp</th>
                            <th scope="col">Category</th>
                            <th scope="col">Provider</th>
                            <th scope="col">Risk score</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _recent.Take(10))
                        {
                            <tr>
                                <th scope="row"><span class="subtle-code">@item.Id</span></th>
                                <td>@item.Timestamp.ToString("dd MMM, HH:mm")</td>
                                <td><span class="subtle-code">@item.Category</span></td>
                                <td>@item.Provider</td>
                                <td><SeverityBadge Value="ScoreToSeverity(item.RiskScore)" /></td>
                                <td><span class="table-status">@item.Status</span></td>
                                <td style="display:flex;gap:0.65rem;align-items:center;">
                                    <button class="text-button" @onclick="() => ViewAuditReportAsync(item.Id)">📄 Audit</button>
                                    <a class="text-button" style="color:#34d399;" href="@($"/optimizer?tab=system_hardener&testId={Uri.EscapeDataString(item.Id)}")">🛡️ Immunize</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_selectedReportContent))
    {
        <section class="surface-card" style="margin-top:1.5rem;" aria-labelledby="audit-viewer-heading">
            <div class="section-heading compact">
                <div>
                    <p class="eyebrow">Security Audit Telemetry</p>
                    <h2 id="audit-viewer-heading">Audit Report: @_selectedReportId</h2>
                </div>
                <div style="display:flex;gap:0.5rem;align-items:center;">
                    <a class="button button-primary" style="font-size:0.8rem;"
                       download="@($"ares-report-{_selectedReportId ?? "executive"}.md")"
                       href="@($"data:text/markdown;charset=utf-8,{Uri.EscapeDataString(_selectedReportContent)}")">
                        📥 Download .md
                    </a>
                    <button class="button button-secondary" style="font-size:0.8rem;" @onclick="CopyReportMarkdownAsync">
                        @(_reportCopied ? "✓ Copied!" : "📋 Copy Markdown")
                    </button>
                    <button class="button button-secondary" style="font-size:0.8rem;" @onclick="() => _selectedReportContent = null">Close</button>
                </div>
            </div>
            <pre style="background:#040711;border:1px solid var(--border);padding:1rem;border-radius:6px;overflow-x:auto;font-size:0.85rem;color:#38bdf8;white-space:pre-wrap;max-height:450px;"><code>@_selectedReportContent</code></pre>
        </section>
    }
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<RecentTestItem>? _recent;
    private HardeningComparison _hardening = new(0, 0, 0, 0, DateOnly.MinValue);
    private StatsResponse? _stats;
    private bool _loading = true;
    private bool _reportCopied;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            _recent    = await Api.GetRecentTestsAsync(_cts.Token);
            _hardening = await Api.GetHardeningComparisonAsync(_cts.Token);
            try { _stats = await Api.GetStatsAsync(_cts.Token); } catch { _stats = null; }
        }
        catch { _error = "Failed to load reports."; }
        finally { _loading = false; }
    }

    private static Severity ScoreToSeverity(int score)
    {
        if (score < 20) return Severity.Safe;
        if (score < 40) return Severity.Low;
        if (score < 60) return Severity.Medium;
        if (score < 80) return Severity.High;
        return Severity.Critical;
    }

    private string? _selectedReportId;
    private string? _selectedReportContent;

    private async Task ViewAuditReportAsync(string testId)
    {
        _selectedReportId = testId;
        _reportCopied = false;
        _selectedReportContent = "Generating security audit report…";
        try
        {
            _selectedReportContent = await Api.GetReportAsync(testId, "markdown", _cts.Token);
        }
        catch
        {
            _selectedReportContent = $"# Error\n\nFailed to load audit report for test '{testId}'.";
        }
    }

    private void GenerateExecutiveSummary()
    {
        _selectedReportId = "executive-compliance-summary";
        _reportCopied = false;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("# ARES Executive AI Resilience & Compliance Audit Summary");
        sb.AppendLine($"**Generated At:** {DateTime.UtcNow:yyyy-MM-dd HH:mm:ss} UTC");
        sb.AppendLine("**Compliance Frameworks:** OWASP LLM Top 10 (2025) · MITRE ATLAS · Zero-Trust AI Gateway");
        sb.AppendLine();
        sb.AppendLine("## 1. Zero-Trust Prompt Hardening Benchmark");
        sb.AppendLine($"- **Baseline Attack Success Rate (ASR):** {_hardening.BaselineSuccessRate}%");
        sb.AppendLine($"- **Hardened Attack Success Rate (ASR):** {_hardening.HardenedSuccessRate}%");
        sb.AppendLine($"- **Net Robustness Gain:** +{_hardening.ImprovementPoints} percentage points across {_hardening.TestsIncluded} controlled test(s)");
        sb.AppendLine();
        sb.AppendLine("## 2. Vector Shield & ML Threat Classification Telemetry");
        if (_stats is not null)
        {
            sb.AppendLine($"- **Qdrant Attack Corpus Size:** {_stats.CorpusSize:N0} embedded adversarial vectors");
            sb.AppendLine($"- **Overall Classifier Accuracy:** {_stats.OverallAccuracy:F1}%");
            sb.AppendLine($"- **5-Fold Cross-Validation Accuracy:** {_stats.CvAccuracy:F1}% (±{_stats.CvStd:F1}%)");
            sb.AppendLine($"- **Active Classifier Pipeline:** `{_stats.ModelName}`");
        }
        else
        {
            sb.AppendLine("- *ML Classifier telemetry pending synchronization.*");
        }
        sb.AppendLine();
        sb.AppendLine("## 3. Recent Controlled Red-Team Evaluations");
        if (_recent is { Count: > 0 })
        {
            sb.AppendLine("| Test ID | Timestamp (UTC) | Category | Provider | Model | Risk Score | Status |");
            sb.AppendLine("|---|---|---|---|---|---|---|");
            foreach (var r in _recent.Take(10))
            {
                sb.AppendLine($"| `{r.Id}` | {r.Timestamp:yyyy-MM-dd HH:mm} | `{r.Category}` | {r.Provider} | `{r.Model}` | {r.RiskScore}% | {r.Status} |");
            }
        }
        else
        {
            sb.AppendLine("- *No controlled red-team evaluations recorded in current window.*");
        }
        _selectedReportContent = sb.ToString();
    }

    private async Task CopyReportMarkdownAsync()
    {
        if (string.IsNullOrEmpty(_selectedReportContent)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _selectedReportContent);
            _reportCopied = true;
            await Task.Delay(2500);
            _reportCopied = false;
        }
        catch
        {
            _reportCopied = true;
        }
    }

    public void Dispose() => _cts.Cancel();
}
