@page "/clients"
@using System.Net.Http.Json
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Config
@inject AresOperatorContext OperatorContext
@inject AresSessionRegistry SessionRegistry

<PageTitle>Integrated Clients &amp; Per-Client Models · ARES</PageTitle>

<section class="page-intro dashboard-intro">
    <div>
        <p class="eyebrow">Tenant Isolation &amp; Partner Sidecars</p>
        <h1>Integrated Clients &amp; Custom Models</h1>
        <p>Manage onboarded LLM applications, isolated canary tokens, per-client DistilBERT threat &amp; LoRA compression adapters, and evaluation metrics.</p>
    </div>
    <div class="intro-meta" style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <div>
            <span>Active Tenants</span>
            <strong>@_clients.Count onboarded</strong>
        </div>
        @if (_isAdmin)
        {
            <button class="button button-primary" style="font-size:0.82rem;padding:0.4rem 0.85rem;" @onclick="() => _showOnboardForm = !_showOnboardForm">
                @(_showOnboardForm ? "Hide Form" : "+ Onboard / Edit Client")
            </button>
        }
        <button class="text-button" @onclick="LoadClientsAsync">Refresh</button>
    </div>
</section>

@if (!string.IsNullOrEmpty(_issuedApiKey))
{
    <section class="surface-card" style="margin-top:1rem;border-left:4px solid #10b981;background:rgba(16,185,129,0.08);">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
            <div>
                <p class="eyebrow" style="color:#34d399;">Tenant-Scoped API Key Issued (Shown Once)</p>
                <p style="margin:0.25rem 0;font-size:0.88rem;">
                    Organization <span class="subtle-code">@_issuedApiKeyOrg</span> key:
                    <code style="padding:0.2rem 0.5rem;background:rgba(0,0,0,0.45);border-radius:4px;user-select:all;">@_issuedApiKey</code>
                </p>
            </div>
            <button class="text-button" @onclick="() => _issuedApiKey = null">Dismiss</button>
        </div>
    </section>
}

@if (_showOnboardForm)
{
    <section class="surface-card" style="margin-top:1rem;border-left:4px solid #38bdf8;">
        <div class="section-heading compact" style="margin-bottom:0.75rem;">
            <div>
                <p class="eyebrow">Tenant &amp; External Staging App</p>
                <h2>Onboard or Update Client Tenant</h2>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:0.75rem;">
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">Organization ID *</label>
                <input class="category-select" style="width:100%;" placeholder="org_partner_ai" @bind="_formOrgId" />
            </div>
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">Display Name</label>
                <input class="category-select" style="width:100%;" placeholder="Partner Support Bot" @bind="_formDisplayName" />
            </div>
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">Domain</label>
                <select class="category-select" style="width:100%;" @bind="_formDomain">
                    <option value="general">General</option>
                    <option value="fintech">Fintech</option>
                    <option value="software">Software / DevOps</option>
                    <option value="healthcare">Healthcare</option>
                </select>
            </div>
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">Application Name</label>
                <input class="category-select" style="width:100%;" placeholder="PartnerSupportRAG" @bind="_formAppName" />
            </div>
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">Canary Token</label>
                <input class="category-select" style="width:100%;" placeholder="CANARY_PARTNER_01" @bind="_formCanary" />
            </div>
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">External Staging Endpoint URL</label>
                <input class="category-select" style="width:100%;" placeholder="https://staging.example.com/v1/chat/completions" @bind="_formTargetUrl" />
            </div>
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">Endpoint Payload Format</label>
                <select class="category-select" style="width:100%;" @bind="_formTargetFormat">
                    <option value="openai_chat">OpenAI Chat (/v1/chat/completions)</option>
                    <option value="json_query">JSON Query ({query, prompt})</option>
                </select>
            </div>
            <div>
                <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:0.25rem;">Target Model Name</label>
                <input class="category-select" style="width:100%;" placeholder="llama3.2:3b" @bind="_formTargetModel" />
            </div>
        </div>
        <div style="display:flex;gap:1rem;align-items:center;margin-top:0.85rem;flex-wrap:wrap;">
            <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.84rem;cursor:pointer;">
                <input type="checkbox" @bind="_formAutoTrain" />
                <span>Auto-train per-client intent &amp; compression adapter immediately</span>
            </label>
            <button class="button button-primary" disabled="@_savingClient" @onclick="SaveClientAsync">
                @(_savingClient ? "Saving..." : "Save Client Tenant")
            </button>
            @if (!string.IsNullOrEmpty(_clientActionError))
            {
                <span style="color:#fca5a5;font-size:0.83rem;">⚠️ @_clientActionError</span>
            }
        </div>
    </section>
}

<section class="metric-grid" aria-label="Client summary metrics">
    <article class="surface-card metric-card">
        <p class="eyebrow">Protected Applications</p>
        <p class="metric-value accent-green">@_clients.Count</p>
        <p class="metric-desc">Isolated tenant security policies</p>
    </article>
    <article class="surface-card metric-card">
        <p class="eyebrow">Trained Client Models</p>
        <p class="metric-value">@_clients.Count(c => !string.Equals(c.ModelVersion, "untrained", StringComparison.OrdinalIgnoreCase))</p>
        <p class="metric-desc">Per-org intent + compression pairs</p>
    </article>
    <article class="surface-card metric-card">
        <p class="eyebrow">Canary Traps Active</p>
        <p class="metric-value" style="color:#38bdf8;">@_clients.Count(c => c.CanaryConfigured)</p>
        <p class="metric-desc">Zero-leak outbound exfiltration traps</p>
    </article>
</section>

<section class="surface-card" style="margin-top:1.5rem;">
    <div class="section-heading compact">
        <div>
            <p class="eyebrow">Client Registry</p>
            <h2>Tenant Targets, Models &amp; ML Metrics</h2>
        </div>
    </div>

    @if (_usingOfflineFallback)
    {
        <div role="status" style="margin:0.75rem 0;padding:0.65rem 0.9rem;border:1px solid rgba(251,191,36,0.45);background:rgba(251,191,36,0.1);border-radius:6px;font-size:0.86rem;">
            <strong>Offline Preview Mode:</strong> Backend API could not be reached — displaying cached reference client profiles instead of the live registry. Click <strong>Refresh</strong> once the backend is online.
        </div>
    }

    <div class="history-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Organization ID</th>
                    <th>Application</th>
                    <th>Domain</th>
                    <th>Canary</th>
                    <th>Model Version</th>
                    <th>Gateway Blocks</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in _clients)
                {
                    <tr>
                        <td><span class="subtle-code">@client.OrgId</span></td>
                        <td>
                            <strong>@client.ApplicationName</strong><br /><small>@client.DisplayName</small>
                            @if (client.TargetEndpointConfigured)
                            {
                                <br /><span style="font-size:0.72rem;color:#38bdf8;">External URL</span>
                            }
                            @if (client.TenantApiKeyConfigured)
                            {
                                <span style="font-size:0.72rem;color:#34d399;margin-left:0.35rem;">Key Scoped</span>
                            }
                        </td>
                        <td>@client.Domain</td>
                        <td><span class="subtle-code">@(client.CanaryTokenPreview ?? "none")</span></td>
                        <td>@client.ModelVersion</td>
                        <td>@client.RecentBlockedEvents / @client.RecentGatewayEvents</td>
                        <td style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                            <button class="button button-secondary" style="font-size:0.78rem;padding:0.25rem 0.6rem;"
                                    @onclick="() => SelectMlStatsAsync(client.OrgId)">
                                ML Stats
                            </button>
                            <button class="button button-secondary" style="font-size:0.78rem;padding:0.25rem 0.6rem;"
                                    @onclick="() => SelectDeploymentConfigAsync(client.OrgId)">
                                Deploy Bundle
                            </button>
                            <button class="button button-secondary" style="font-size:0.78rem;padding:0.25rem 0.6rem;"
                                    @onclick="() => RotateApiKeyAsync(client.OrgId)">
                                Rotate Key
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (_selectedStats is not null)
{
    <section class="surface-card" style="margin-top:1.5rem;">
        <div class="section-heading compact">
            <div>
                <p class="eyebrow">5-Fold Cross-Validation &amp; Out-of-Fold Metrics</p>
                <h2>ML Statistics · @_selectedStats.OrgId (@_selectedStats.Domain)</h2>
            </div>
            <button class="text-button" @onclick="() => _selectedStats = null">Close</button>
        </div>

        <div class="metric-grid" style="margin-bottom:1rem;">
            <article class="surface-card metric-card">
                <p class="eyebrow">Threat Classifier CV Acc</p>
                <p class="metric-value accent-green">@(_selectedStats.ThreatCvAcc.ToString("P1"))</p>
                <p class="metric-desc">P=@(_selectedStats.ThreatPrecision.ToString("P1")) · R=@(_selectedStats.ThreatRecall.ToString("P1")) · F1=@(_selectedStats.ThreatF1.ToString("P1"))</p>
            </article>
            <article class="surface-card metric-card">
                <p class="eyebrow">Intent Classifier CV Acc</p>
                <p class="metric-value accent-green">@(_selectedStats.IntentCvAcc.ToString("P1"))</p>
                <p class="metric-desc">P=@(_selectedStats.IntentPrecision.ToString("P1")) · R=@(_selectedStats.IntentRecall.ToString("P1")) · F1=@(_selectedStats.IntentF1.ToString("P1"))</p>
            </article>
            <article class="surface-card metric-card">
                <p class="eyebrow">Adapter Avg Savings</p>
                <p class="metric-value" style="color:#38bdf8;">@(_selectedStats.AvgTokenSavings.ToString("P1"))</p>
                <p class="metric-desc">Domain SFT token compression ratio</p>
            </article>
        </div>

        @if (_selectedStats.Categories.Count > 0)
        {
            <div class="history-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Model</th>
                            <th>Category</th>
                            <th>Precision</th>
                            <th>Recall</th>
                            <th>F1-Score</th>
                            <th>Support</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in _selectedStats.Categories)
                        {
                            <tr>
                                <td>@cat.Model</td>
                                <td><span class="subtle-code">@cat.Category</span></td>
                                <td>@cat.Precision.ToString("P1")</td>
                                <td>@cat.Recall.ToString("P1")</td>
                                <td><strong>@cat.F1Score.ToString("P1")</strong></td>
                                <td>@cat.Support</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (!string.IsNullOrEmpty(_selectedDeployYaml))
{
    <section class="surface-card" style="margin-top:1.5rem;">
        <div class="section-heading compact">
            <div>
                <p class="eyebrow">Partner Deployment Kit</p>
                <h2>Sidecar &amp; OpenAI Proxy Config · @_selectedOrgId</h2>
            </div>
            <button class="text-button" @onclick="() => { _selectedDeployYaml = null; _selectedOpenAiSnippet = null; }">Close</button>
        </div>
        <p style="font-size:0.8rem;color:#94a3b8;margin:0.4rem 0;">Docker Compose Sidecar</p>
        <pre style="padding:0.9rem;background:rgba(0,0,0,0.35);border-radius:6px;overflow-x:auto;font-size:0.82rem;">@_selectedDeployYaml</pre>
        @if (!string.IsNullOrEmpty(_selectedOpenAiSnippet))
        {
            <p style="font-size:0.8rem;color:#94a3b8;margin:0.85rem 0 0.4rem 0;">Drop-In OpenAI Reverse Proxy SDK Snippet (/v1/chat/completions)</p>
            <pre style="padding:0.9rem;background:rgba(0,0,0,0.35);border-radius:6px;overflow-x:auto;font-size:0.82rem;">@_selectedOpenAiSnippet</pre>
        }
    </section>
}

@code {
    private sealed record ClientRow(
        string OrgId,
        string DisplayName,
        string Domain,
        string ApplicationName,
        bool CanaryConfigured,
        string? CanaryTokenPreview,
        string ModelVersion,
        int RecentGatewayEvents,
        int RecentBlockedEvents,
        bool TargetEndpointConfigured = false,
        string? TargetEndpointUrl = null,
        string TargetRequestFormat = "openai_chat",
        string? TargetModel = null,
        bool TenantApiKeyConfigured = false
    );

    private sealed record CategoryMetricRow(
        string Model,
        string Category,
        double Precision,
        double Recall,
        double F1Score,
        int Support
    );

    private sealed class ClientStatsView
    {
        public string OrgId { get; init; } = "";
        public string Domain { get; init; } = "";
        public double ThreatCvAcc { get; init; }
        public double ThreatPrecision { get; init; }
        public double ThreatRecall { get; init; }
        public double ThreatF1 { get; init; }
        public double IntentCvAcc { get; init; }
        public double IntentPrecision { get; init; }
        public double IntentRecall { get; init; }
        public double IntentF1 { get; init; }
        public double AvgTokenSavings { get; init; }
        public List<CategoryMetricRow> Categories { get; init; } = new();
    }

    private List<ClientRow> _clients = new();
    private bool _usingOfflineFallback;
    private bool _showOnboardForm;
    private bool _savingClient;
    private string? _clientActionError;
    private string _formOrgId = "";
    private string _formDisplayName = "";
    private string _formDomain = "general";
    private string _formAppName = "";
    private string _formCanary = "";
    private string _formTargetUrl = "";
    private string _formTargetFormat = "openai_chat";
    private string _formTargetModel = "";
    private bool _formAutoTrain;
    private string? _issuedApiKey;
    private string? _issuedApiKeyOrg;
    private string? _selectedOrgId;
    private string? _selectedDeployYaml;
    private string? _selectedOpenAiSnippet;
    private ClientStatsView? _selectedStats;
    private AresOperatorSession? _session;
    private bool _isAdmin => _session?.IsAdmin ?? false;

    protected override async Task OnInitializedAsync()
    {
        _session = await OperatorContext.GetSessionAsync();
        await LoadClientsAsync();
    }

    private Task<HttpClient> CreateApiClientAsync() => OperatorContext.CreateScopedApiClientAsync(HttpClientFactory, Config);

    private List<ClientRow> FilterForSession(List<ClientRow> rows)
    {
        if (_session is null) return new List<ClientRow>();
        return _session.IsAdmin
            ? rows
            : rows.Where(r => _session.CanAccessOrganization(r.OrgId)).ToList();
    }

    private async Task LoadClientsAsync()
    {
        _session ??= await OperatorContext.GetSessionAsync();
        if (_session is null)
        {
            _clients = new List<ClientRow>();
            return;
        }
        try
        {
            using var http = await CreateApiClientAsync();
            var opts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower };
            var rows = await http.GetFromJsonAsync<List<ClientRow>>("api/v1/clients", opts);
            if (rows is not null && rows.Count > 0)
            {
                _clients = FilterForSession(rows);
                _usingOfflineFallback = false;
                return;
            }
        }
        catch
        {
            // Offline preview fallback matching the 3 reference targets
        }

        _usingOfflineFallback = true;
        var fallback = new List<ClientRow>
        {
            new("org_acme_fintech", "Acme Fintech RAG", "fintech", "AcmeFintechRAG", true, "CANARY_ACM...77", "v1.0", 16, 11),
            new("org_dev_ops_agent", "DevOps Tool Agent", "software", "DevOpsToolAgent", true, "CANARY_DEV...88", "v1.0", 17, 12),
            new("org_medshield_health", "MedShield HIPAA Triage", "healthcare", "MedShieldTriage", true, "CANARY_MED...99", "v1.0", 16, 11),
        };
        _clients = FilterForSession(fallback);
    }

    private async Task SaveClientAsync()
    {
        _clientActionError = null;
        if (!_isAdmin)
        {
            _clientActionError = "Only Platform Admin operators can onboard or modify client tenants.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_formOrgId))
        {
            _clientActionError = "Organization ID is required.";
            return;
        }
        _savingClient = true;
        try
        {
            using var http = await CreateApiClientAsync();
            var payload = new
            {
                org_id = _formOrgId.Trim(),
                display_name = string.IsNullOrWhiteSpace(_formDisplayName) ? null : _formDisplayName.Trim(),
                domain = _formDomain,
                application_name = string.IsNullOrWhiteSpace(_formAppName) ? null : _formAppName.Trim(),
                canary_token = string.IsNullOrWhiteSpace(_formCanary) ? null : _formCanary.Trim(),
                target_endpoint_url = string.IsNullOrWhiteSpace(_formTargetUrl) ? null : _formTargetUrl.Trim(),
                target_request_format = _formTargetFormat,
                target_model = string.IsNullOrWhiteSpace(_formTargetModel) ? null : _formTargetModel.Trim(),
                auto_train = _formAutoTrain
            };
            var resp = await http.PostAsJsonAsync("api/v1/clients", payload);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                _clientActionError = $"Failed ({(int)resp.StatusCode}): {body}";
                return;
            }
            _showOnboardForm = false;
            await LoadClientsAsync();
        }
        catch (Exception ex)
        {
            _clientActionError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _savingClient = false;
        }
    }

    private async Task RotateApiKeyAsync(string orgId)
    {
        _clientActionError = null;
        try
        {
            using var http = await CreateApiClientAsync();
            var resp = await http.PostAsJsonAsync($"api/v1/clients/{orgId}/api-key", new { });
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
                if (json.TryGetProperty("api_key", out var keyProp))
                {
                    var newKey = keyProp.GetString();
                    _issuedApiKey = newKey;
                    _issuedApiKeyOrg = orgId;
                    // If a tenant operator rotated their own org's key, refresh their active session key to prevent self-lockout
                    if (_session is not null && !_session.IsAdmin && _session.CanAccessOrganization(orgId) && !string.IsNullOrWhiteSpace(newKey))
                    {
                        var updated = SessionRegistry.UpdateApiKey(_session.SessionId, newKey);
                        if (updated is not null)
                        {
                            _session = updated;
                            OperatorContext.SetSession(updated);
                        }
                    }
                    await LoadClientsAsync();
                }
            }
        }
        catch (Exception ex)
        {
            _clientActionError = $"Key rotation failed: {ex.Message}";
        }
    }

    private async Task SelectMlStatsAsync(string orgId)
    {
        try
        {
            using var http = await CreateApiClientAsync();
            var json = await http.GetFromJsonAsync<JsonElement>($"api/v1/clients/{orgId}/stats");
            var threat = json.TryGetProperty("threat_ml_stats", out var tProp) ? tProp : default;
            var intent = json.TryGetProperty("intent_ml_stats", out var iProp) ? iProp : default;
            var comp = json.TryGetProperty("compression_stats", out var cProp) ? cProp : default;

            var rows = new List<CategoryMetricRow>();
            AppendCategories(rows, "Threat", threat);
            AppendCategories(rows, "Intent", intent);

            _selectedStats = new ClientStatsView
            {
                OrgId = orgId,
                Domain = json.TryGetProperty("domain", out var dProp) ? (dProp.GetString() ?? "general") : "general",
                ThreatCvAcc = ReadDouble(threat, "cv_mean_accuracy"),
                ThreatPrecision = ReadDouble(threat, "macro_precision"),
                ThreatRecall = ReadDouble(threat, "macro_recall"),
                ThreatF1 = ReadDouble(threat, "macro_f1"),
                IntentCvAcc = ReadDouble(intent, "cv_mean_accuracy"),
                IntentPrecision = ReadDouble(intent, "macro_precision"),
                IntentRecall = ReadDouble(intent, "macro_recall"),
                IntentF1 = ReadDouble(intent, "macro_f1"),
                AvgTokenSavings = ReadDouble(comp, "observed_avg_token_savings"),
                Categories = rows,
            };
        }
        catch
        {
            _selectedStats = new ClientStatsView { OrgId = orgId, Domain = "offline" };
        }
    }

    private static double ReadDouble(JsonElement el, string propName)
        => el.ValueKind == JsonValueKind.Object && el.TryGetProperty(propName, out var v) && v.ValueKind == JsonValueKind.Number
            ? v.GetDouble()
            : 0.0;

    private static void AppendCategories(List<CategoryMetricRow> rows, string modelLabel, JsonElement block)
    {
        if (block.ValueKind != JsonValueKind.Object || !block.TryGetProperty("category_breakdown", out var arr) || arr.ValueKind != JsonValueKind.Array)
            return;

        foreach (var item in arr.EnumerateArray())
        {
            rows.Add(new CategoryMetricRow(
                modelLabel,
                item.TryGetProperty("category", out var c) ? (c.GetString() ?? "") : "",
                ReadDouble(item, "precision"),
                ReadDouble(item, "recall"),
                ReadDouble(item, "f1_score"),
                item.TryGetProperty("support", out var s) && s.ValueKind == JsonValueKind.Number ? s.GetInt32() : 0
            ));
        }
    }

    private async Task SelectDeploymentConfigAsync(string orgId)
    {
        _selectedOrgId = orgId;
        _selectedOpenAiSnippet = null;
        try
        {
            using var http = await CreateApiClientAsync();
            var json = await http.GetFromJsonAsync<JsonElement>($"api/v1/clients/{orgId}/deployment-config");
            if (json.TryGetProperty("openai_proxy_snippet", out var openAiProp))
            {
                _selectedOpenAiSnippet = openAiProp.GetString();
            }
            if (json.TryGetProperty("docker_compose_yaml", out var composeProp))
            {
                _selectedDeployYaml = composeProp.GetString();
                return;
            }
        }
        catch
        {
            // Fallback preview snippet if backend API is offline
        }
        _selectedDeployYaml = $"./deploy_partner.sh --org={orgId} --api-key=<YOUR_ARES_API_KEY>";
    }
}
